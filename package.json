{
  "name": "catalog_server",
  "version": "1.0.0",
  "description": "MERN Ecommerce Catalog microservice — product, category, brand, review, wishlist. Deployed/run independently of the other services and the API gateway.",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "start": "cross-env NODE_ENV=production node index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "analyze:complexity": "eslint --no-eslintrc --env node,es2021 --parser-options=ecmaVersion:2021 --rule \"{\\\"complexity\\\": [\\\"warn\\\", 1]}\" \"**/*.js\" --ignore-pattern node_modules --ignore-pattern coverage --ignore-pattern \"**/*.test.js\" --ignore-pattern tests"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^8.0.0",
    "express": "^4.17.1",
    "helmet": "^4.6.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^6.13.11",
    "mongoose-slug-generator": "^1.0.4",
    "passport": "^0.4.0",
    "passport-jwt": "^4.0.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "bcryptjs": "^2.4.3",
    "cross-env": "^5.2.1",
    "eslint": "^8.57.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^1.19.1",
    "supertest": "^7.2.2"
  }
}
